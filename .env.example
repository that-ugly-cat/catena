# catena — environment

# JWT secret. Startup fails without it, on purpose: a default secret is worse
# than no secret.
JWT_SECRET=

# Where the database lives (a single file).
CATENA_DB=data/catena.db

# Public URL, used to build the MCP endpoints shown on the profile page.
PUBLIC_URL=https://catena.borant.eu

# Sign-in mode: `local` (this app's own users table) or `gateway` (Borant ID
# vouches for the caller through X-Borant-* headers). `local` is the default
# for security before portability — see DEPLOY.md.
AUTH_MODE=local

# Only meaningful with AUTH_MODE=gateway: the address identity headers are
# believed from. Under Docker this is the bridge gateway, NOT 127.0.0.1.
BORANT_TRUSTED_PROXY=127.0.0.1
